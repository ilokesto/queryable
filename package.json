{
  "name": "@ilokesto/queryable",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "description": "Private beta: a shared-prototype, Symbol-based record query DSL.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "test": "vitest run",
    "bench": "pnpm build && node --expose-gc bench/benchmark.mjs --early-limit",
    "migrate:verify": "node scripts/verify-migration.mjs all",
    "release:verify": "node scripts/release-verify.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilokesto/queryable.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "26.2.0",
    "remeda": "2.51.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
