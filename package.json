{
  "name": "@ilokesto/queryable",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.22.1"
  },
  "private": false,
  "packageManager": "pnpm@10.17.1",
  "description": "A shared-prototype, Symbol-based record query DSL.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "test": "vitest run src",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "bench": "pnpm build && node --expose-gc bench/benchmark.mjs --early-limit",
    "migrate:verify": "node scripts/verify-migration.mjs all",
    "release:verify": "node scripts/release-verify.mjs",
    "docs:prepare": "pnpm build && pnpm --dir website exec fumadocs-mdx",
    "docs:build": "pnpm docs:prepare && pnpm --dir website build",
    "docs:typecheck": "pnpm docs:prepare && pnpm --dir website typecheck",
    "docs:test": "pnpm --dir website test",
    "docs:start": "pnpm --dir website start",
    "docs:http": "node scripts/docs-http.mjs",
    "docs:publication:verify": "node scripts/docs-publication.mjs verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilokesto/queryable.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@types/node": "26.2.0",
    "remeda": "2.51.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "yaml": "2.8.2"
  }
}
