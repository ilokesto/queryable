{
  "name": "@ilokesto/queryable",
  "version": "0.1.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "private": false,
  "packageManager": "pnpm@10.17.1",
  "description": "A shared-prototype, Symbol-based record query DSL.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./streams": {
      "types": "./dist/streams.d.ts",
      "import": "./dist/streams.js"
    },
    "./operators": {
      "types": "./dist/functional.d.ts",
      "import": "./dist/functional.js"
    },
    "./symbols": {
      "types": "./dist/symbols.d.ts",
      "import": "./dist/symbols.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && pnpm test:unit && pnpm test:types && pnpm test:tooling",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "bench": "pnpm build && node --expose-gc bench/benchmark.mjs --early-limit",
    "release:verify": "node scripts/release-verify.mjs",
    "test:unit": "vitest run tests/unit",
    "test:types": "tsc --noEmit -p tests/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilokesto/queryable.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@types/node": "26.2.0",
    "remeda": "2.51.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "yaml": "2.8.2"
  }
}
